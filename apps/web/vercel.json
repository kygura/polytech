{
  "regions": [
    "arn1"
  ],
  "buildCommand": "bun scripts/migrate-deploy.ts && turbo run build",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/snapshot?scope=all",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/screen",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/research",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/calibrate",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/monitor",
      "schedule": "30 5 * * *"
    }
  ]
}
