{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "PM_FIXTURES",
    "ANTHROPIC_API_KEY",
    "EXA_API_KEY",
    "CRON_SECRET",
    "REDIS_URL",
    "REDIS_PREFIX",
    "STORE_FILE",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "REDIS_TEST_URL"
  ]
}
