ANTHROPIC_API_KEY=
EXA_API_KEY=
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
PM_FIXTURES=
# Live trading (L2). Use a DEDICATED low-balance wallet funded only up to bankroll; this key can spend everything in it. Unset = L2 disabled.
PM_PRIVATE_KEY=
# eoa | deposit (default deposit, the SDK default)
PM_SIGNATURE_TYPE=
# ntfy push for approvals; unset = no push. Pick an unguessable topic: anyone subscribed sees the approve/reject actions.
NTFY_TOPIC=
# ntfy server (default https://ntfy.sh)
NTFY_URL=
# ntfy access token for a protected topic (optional)
NTFY_TOKEN=
# public base URL of this app, used in the push action links (e.g. https://pm.example.com)
APP_URL=
